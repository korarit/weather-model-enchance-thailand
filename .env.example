# ==============================================================================
# weather-forcast-enhance Storage Path Configuration (.env)
# ==============================================================================
# All paths can be specified via CLI arguments (recommended) or configured here.
#
# 1. HII Ground Station Data (Separate Drive / Storage)
# Example: HII_DATA_DIR="D:/datasets/hii_ground_data"
# HII_DATA_DIR="data"
# HII_CLEAN_DIR="data/clean_parquet"
# HII_META_DIR="data/metadata"
# HII_AUDIT_DIR="data/audit"

# 2. Weather Forecast & Satellite Data (Separate Drive / High Volume Storage)
# Example: FORECAST_DATA_DIR="E:/datasets/nwp_forecasts"
# FORECAST_DATA_DIR="data"
# NWP_RAW_DIR="data/raw/nwp_runs"
# NWP_FORECASTS_DIR="data/nwp_forecasts"
# HIMAWARI_DIR="data/himawari9"

# 3. Common Geographic & ML Features
# GEO_DATA_DIR="data/geo"
# FEATURES_DIR="data/features"
